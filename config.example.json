{
  "interval_seconds": 30,
  "timeout_seconds": 5,
  "endpoints": [
    {
      "name": "Solana Mainnet",
      "url": "https://api.mainnet-beta.solana.com",
      "method": "getSlot",
      "params": [],
      "result_path": "result",
      "latency_threshold_ms": 1200,
      "height_lag_threshold": 10
    },
    {
      "name": "Ethereum (publicnode)",
      "url": "https://ethereum-rpc.publicnode.com",
      "method": "eth_blockNumber",
      "params": [],
      "result_path": "result",
      "latency_threshold_ms": 1000,
      "height_lag_threshold": 3
    },
    {
      "name": "Somnia Mainnet",
      "url": "https://api.infra.mainnet.somnia.network",
      "method": "eth_blockNumber",
      "params": [],
      "result_path": "result",
      "latency_threshold_ms": 1000,
      "height_lag_threshold": 5
    }
  ]
}
